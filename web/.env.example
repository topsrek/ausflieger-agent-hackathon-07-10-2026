# Leave both empty to run with the in-memory LocalStore (simulated agent, offline demo data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: demo trip (is_demo = true) cloned by "Open the Munich demo".
# Defaults to the prepared Munich trip 2027a10d-0203-4000-8000-00000000c0de.
VITE_DEMO_TRIP_ID=

# Runtime equivalents read by server.mjs (served as /config.js, override the VITE_* build-time values):
# SUPABASE_URL=  SUPABASE_ANON_KEY=  DEMO_TRIP_ID=  PORT=8080
