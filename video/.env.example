# Copy to video/.env and fill in locally. video/.env is gitignored; never commit it.
# ElevenLabs API key (Profile -> API keys). Needs text-to-speech permission.
ELEVENLABS_API_KEY=
# Voice id from the ElevenLabs Voice Library (Voices -> ... -> Copy voice ID).
# Leave empty to use the default in scripts/voiceover.mjs.
ELEVENLABS_VOICE_ID=
# Optional: override the model from script.json (e.g. eleven_multilingual_v2, eleven_v3)
ELEVENLABS_MODEL_ID=
# Optional: base URL for scripts/record-app.mjs (default http://localhost:5173)
APP_BASE_URL=
